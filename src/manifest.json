{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "2.0.0",
  "homepage_url": "https://github.com/mhdzli/mahoor",
  "author": "M.Zeinali",
  "browser_specific_settings": {
    "gecko": {
      "id": "mahour@zmim.ir",
      "strict_min_version": "159.0",
      "strict_max_version": "160.*"
    }
  },
  "background": {
    "scripts": [
      "background/background.js"
    ]
  },
  "icons": {
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "64": "assets/icons/icon64.png",
    "128": "assets/icons/icon128.png"
  },
  "experiment_apis": {
    "customColumns": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "customColumns"
          ]
        ],
        "script": "api/implementation.js"
      }
    },
    "persianCalendar": {
      "schema": "api/calendar-schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "persianCalendar"
          ]
        ],
        "script": "api/calendar.js"
      }
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage",
    "compose",
    "messagesModify"
  ]
}
